# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=control_practicas
DB_USER=control_practicas
DB_PASS=change-me

# Docker/MySQL initialization
MYSQL_DATABASE=control_practicas
MYSQL_USER=control_practicas
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# Application
APP_PORT=8080
APP_ENV=production
APP_URL=http://localhost:8080

# Dynamic QR secret: replace with at least 32 random characters
QR_SECRET=replace-with-a-random-secret-at-least-32-characters

# Secreto de la clave numérica de asistencia (opcional, mínimo 32 caracteres; si falta se deriva de QR_SECRET)
CLAVE_SECRET=replace-with-another-random-secret-at-least-32-characters

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cuenta@gmail.com
SMTP_PASS=cambiar-por-contraseña-de-aplicacion
SMTP_FROM=cuenta@gmail.com
SMTP_NAME=Control de Prácticas
SMTP_INSECURE=false
